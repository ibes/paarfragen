# Editor defaults for files Mago/Prettier don't format.
#
# Canonical PHP style (api/src/, api/tests/): `script/format` / `bin/mago fmt`
# per mago.toml. Canonical frontend/ style (ts/vue/css/…): `script/format-frontend`
# / Prettier. On conflict, the formatter wins — run it, then `script/check`.
# Do not use another formatter on either tool's scanned paths.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml,css,ts,vue}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
