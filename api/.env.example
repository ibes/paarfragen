# Copy to .env and fill in. Never commit .env.
# SIGNING_KEY: generate locally once PHP 8.5 + Tempest CLI are available
# (script/tempest key:generate, once that script exists — see SETUP-LOG.md).

SIGNING_KEY=
APPLICATION_NAME=paarfragen-api
BASE_URI=http://127.0.0.1:8000
ENVIRONMENT=local

# MCP_AUTH_TOKEN: shared secret protecting the /mcp app-feedback triage
# route (src/Infrastructure/Http/McpAuthMiddleware.php). Generate a
# random value locally, e.g. `openssl rand -hex 32`. Unset = the route
# rejects every request (fails closed), not "any token is valid".
MCP_AUTH_TOKEN=
