{
    "name": "ibes/paarfragen-api",
    "description": "Paarfragen API — hexagonal core on Tempest",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "tempest/framework": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3@dev"
    },
    "autoload": {
        "psr-4": {
            "Paarfragen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Paarfragen\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
