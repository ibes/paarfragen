# PHP (api/)
/api/vendor/
/api/.phpunit.cache/
/api/.phpunit.result.cache
/api/composer.phar

# SQLite databases — Tempest's default dev DB location and the
# dedicated testing DB (api/tests/database.testing.config.php). Never
# committed; script/tempest migrate:up recreates the dev one.
/api/.tempest/
/api/tests/testing.sqlite

# Mago — downloaded by script/lib/mago-install, pinned version lives in that
# script, not in git.
/bin/mago

# Node (frontend/ has its own .gitignore too; these cover anything at root)
node_modules/
dist/

# Env / secrets
.env
.env.*
!.env.example

# Written by .claude/hooks/session-start.sh in a Claude Code Remote
# session only — see .devcontainer/Dockerfile's HAS_SESSION_CA build-arg.
/.devcontainer/session-ca.crt

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local overrides
.claude/settings.local.json
