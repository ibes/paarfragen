#!/usr/bin/env bash
# Description: Dev setup — build the api/ container, install API and frontend dependencies, fetch Mago, install the pre-commit hook. Safe to re-run.
# Side-effects: WRITES api/vendor/, frontend/node_modules/, bin/mago, .git/hooks/pre-commit; builds/pulls the api/ Docker image.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "Installing API dependencies (composer, inside the PHP 8.5 container)..."
script/lib/api-php composer install --no-interaction

echo "Installing frontend dependencies (npm)..."
(cd frontend && npm install)

echo "Fetching Mago (formatter/linter/analyzer/guard)..."
script/lib/mago-install
bin/mago --version

script/hooks/install
