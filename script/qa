#!/usr/bin/env bash
# Description: Local gate — runs script/test-api and script/test-frontend, then the frontend build.
# Side-effects: WRITES api/vendor/ or frontend/node_modules/ if dependencies changed since the last install; none on tracked source otherwise.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== api tests =="
script/test-api

echo "== frontend tests =="
script/test-frontend

echo "== frontend: typecheck + build =="
(cd frontend && npm run build)
