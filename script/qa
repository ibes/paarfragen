#!/usr/bin/env bash
# Description: Local gate — API test suite (phpunit) + frontend typecheck and build.
# Side-effects: WRITES api/vendor/ or frontend/node_modules/ if dependencies changed since the last install; none on tracked source otherwise.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== api: composer install =="
(cd api && composer install --no-interaction --quiet)

echo "== api: phpunit =="
(cd api && vendor/bin/phpunit)

echo "== frontend: npm install =="
(cd frontend && npm install --no-audit --no-fund)

echo "== frontend: typecheck + build =="
(cd frontend && npm run build)
