#!/usr/bin/env bash
# Description: Read-only static checks — composer.json validity, frontend typecheck. No test run, no build output.
# Side-effects: none (read-only).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== api: composer validate =="
(cd api && composer validate --no-check-publish --no-interaction)

echo "== frontend: vue-tsc typecheck =="
(cd frontend && npx vue-tsc --noEmit)
